# AgriGate Database Connection Configuration Example
# For Supabase runtime, use the transaction pooler URL (port 6543).
# Use the direct/session URL (port 5432) for migrations.
DATABASE_URL=postgresql://postgres.tdkqpvmeasxlpwijvook:houssem120496@aws-1-eu-west-1.pooler.supabase.com:5432/postgres

PGHOST=localhost
PGPORT=5433
PGUSER=agrigat_user
PGPASSWORD=agrigat_secret_pwd
PGDATABASE=agrigat_db

# MQTT broker (Mosquitto, docker-compose)
MQTT_BROKER_URL=mqtt://localhost:1884

# JWT signing secret — generate per environment: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-random-64-hex

# Public URL of the deployed Express API, used by the Next.js browser client.
# NEXT_PUBLIC_API_URL=https://agrigate-api.example.com
